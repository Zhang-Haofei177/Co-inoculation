# ======================================================================
# 修正：从EC丰度行名中提取EC编号，并正确汇总到CAZy家族
# ======================================================================
library(tidyverse)
input_dir <- "D:/张豪飞整个d盘/科研数据/雨养农业保水课题/保水课题小论文/25数据小论文分析/协同效应/输出和脚本/宏基因组分析/input"
# ======================================================================
# 宏基因组分析：CAZy家族丰度计算 + 微生物贡献识别
# ======================================================================
library(tidyverse)
library(vegan)
library(pheatmap)
library(ggpubr)
library(psych)
out_root <- "D:/张豪飞整个d盘/科研数据/雨养农业保水课题/保水课题小论文/25数据小论文分析/协同效应/输出和脚本/宏基因组分析"
input_dir <- file.path(out_root, "input")
result_dir <- file.path(out_root, "CAZy_microbe_link")
dir.create(result_dir, showWarnings = FALSE, recursive = TRUE)
# 1. 读取EC丰度表
ec_abund <- read.table(file.path(input_dir, "Unigenes.absolute.ec.xls"),
header = TRUE, sep = "\t", row.names = 1, check.names = FALSE)
# 提取行名中的EC编号
extract_ec_from_name <- function(name) {
# 匹配 "EC 3.2.1.157" 或 "EC 3.2.1.-" 等
m <- regmatches(name, regexpr("EC\\s+[0-9.\\-]+", name))
if (length(m) == 0) return(NA)
gsub("EC\\s+", "", m)
}
ec_ids <- sapply(rownames(ec_abund), extract_ec_from_name)
# 添加EC列，并移除无法提取的行
ec_abund$EC <- ec_ids
ec_abund <- ec_abund[!is.na(ec_abund$EC), ]
# 移除可能的Description列（如果存在且是最后一列）
if (colnames(ec_abund)[ncol(ec_abund)-1] == "Description") {
ec_abund$Description <- NULL
}
extract_ec_from_desc <- function(desc) {
m <- regmatches(desc, regexpr("EC\\s+[0-9.\\-]+", desc))
if (length(m) == 0) return(NA)
gsub("EC\\s+", "", m)
}
cazy_anno$EC <- sapply(cazy_anno$Description, extract_ec_from_desc)
cazy_anno <- cazy_anno %>% filter(!is.na(EC))
# 3. 建立 EC -> CAZy家族 映射（每个EC取出现最多的家族）
ec_to_family <- cazy_anno %>%
group_by(EC, CAZy_Family) %>%
summarise(n = n(), .groups = "drop") %>%
group_by(EC) %>%
slice_max(order_by = n, n = 1) %>%
ungroup() %>%
select(EC, CAZy_Family) %>%
distinct()
# 4. 将EC丰度长格式化，并与家族合并
ec_abund_long <- ec_abund %>%
rownames_to_column("Enzyme") %>%
select(-Enzyme) %>%  # 丢弃行名，保留EC和样本列
pivot_longer(cols = -EC, names_to = "Sample", values_to = "Abundance")
cazy_family_abund <- ec_abund_long %>%
inner_join(ec_to_family, by = "EC") %>%
group_by(Sample, CAZy_Family) %>%
summarise(Abundance = sum(Abundance), .groups = "drop") %>%
pivot_wider(names_from = CAZy_Family, values_from = Abundance, values_fill = 0) %>%
column_to_rownames("Sample")
View(cazy_family_abund)
# 检查结果
print(dim(cazy_family_abund))
print(colnames(cazy_family_abund)[1:10])
# 保存中间结果（可选）
write.csv(cazy_family_abund, file.path(input_dir, "CAZy_family_abundance_from_EC.csv"))
head(cazy_family_abund)
head(cazy_family_abund)[1:6,1:6]
