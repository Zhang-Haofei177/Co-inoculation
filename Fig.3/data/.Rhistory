# ======================================================================
# 宏基因组分析：CAZy家族丰度计算 + 微生物贡献识别
# ======================================================================
library(tidyverse)
library(vegan)
library(pheatmap)
library(ggpubr)
library(psych)
out_root <- "D:/张豪飞整个d盘/科研数据/雨养农业保水课题/保水课题小论文/25数据小论文分析/协同效应/输出和脚本/宏基因组分析"
input_dir <- file.path(out_root, "input")
result_dir <- file.path(out_root, "CAZy_microbe_link")
dir.create(result_dir, showWarnings = FALSE, recursive = TRUE)
# ---------- 1. 读取EC丰度表 ----------
ec_abund <- read.table(file.path(input_dir, "Unigenes.absolute.ec.xls"),
header = TRUE, sep = "\t", row.names = 1, check.names = FALSE)
# 移除Description列（如果它在最后一列）
if (colnames(ec_abund)[ncol(ec_abund)] == "Description") {
desc <- ec_abund$Description
ec_abund <- ec_abund[, -ncol(ec_abund)]
} else {
desc <- rownames(ec_abund)  # 假设EC ID在行名
}
# 确保数值型
ec_abund <- as.matrix(ec_abund)
mode(ec_abund) <- "numeric"
# ---------- 2. 读取CAZy注释，建立EC -> CAZy家族映射 ----------
cazy_anno <- read.delim(file.path(input_dir, "Unigenes.CAZy.tax.xls"),
stringsAsFactors = FALSE)
# 从Description列提取EC编号（正则匹配）
# Description示例："(Aralpha-f)3-Hyp beta-L-arabinobiosidase (EC 3.2.1.187)"
extract_ec <- function(desc) {
match <- regmatches(desc, regexpr("EC [0-9.]+", desc))
if (length(match) == 0) return(NA)
return(gsub("EC ", "", match))
}
cazy_anno$EC <- sapply(cazy_anno$Description, extract_ec)
View(cazy_anno)
# 过滤掉无法提取EC的行
cazy_anno <- cazy_anno %>% filter(!is.na(EC))
# 每个EC可能对应多个基因，取第一个CAZy家族（通常一致，若不一致取多数）
ec_to_family <- cazy_anno %>%
group_by(EC, CAZy_Family) %>%
summarise(n = n(), .groups = "drop") %>%
group_by(EC) %>%
slice_max(order_by = n, n = 1) %>%  # 取出现最多的家族
ungroup() %>%
select(EC, CAZy_Family) %>%
distinct()
View(ec_to_family)
# ---------- 3. 将EC丰度汇总到CAZy家族 ----------
# 只保留有映射的EC
common_ec <- intersect(rownames(ec_abund), ec_to_family$EC)
ec_abund <- ec_abund[common_ec, ]
ec_to_family <- ec_to_family %>% filter(EC %in% common_ec)
# 合并
ec_abund_df <- as.data.frame(ec_abund) %>%
rownames_to_column("EC") %>%
pivot_longer(cols = -EC, names_to = "Sample", values_to = "Abundance") %>%
left_join(ec_to_family, by = "EC")
# 按样本+家族汇总
cazy_family_abund <- ec_abund_df %>%
group_by(Sample, CAZy_Family) %>%
summarise(Abundance = sum(Abundance), .groups = "drop") %>%
pivot_wider(names_from = CAZy_Family, values_from = Abundance, values_fill = 0) %>%
column_to_rownames("Sample")
# 查看前几个家族
colnames(cazy_family_abund)
# 每个EC可能对应多个基因，取第一个CAZy家族（通常一致，若不一致取多数）
ec_to_family <- cazy_anno %>%
group_by(EC, CAZy_Family) %>%
summarise(n = n(), .groups = "drop") %>%
group_by(EC) %>%
slice_max(order_by = n, n = 1) %>%  # 取出现最多的家族
ungroup() %>%
select(EC, CAZy_Family) %>%
distinct()
# ---------- 3. 将EC丰度汇总到CAZy家族 ----------
# 只保留有映射的EC
common_ec <- intersect(rownames(ec_abund), ec_to_family$EC)
rownames(ec_abund)
