}
# ================================================================
# 1. 读取表型数据
# ================================================================
yield_df <- read.csv(file.path(env_base,"01_春玉米产量和水肥利用率分析和绘图/产量和水肥利用效率绘图数据.csv"),
header=TRUE, check.names=FALSE)
colnames(yield_df) <- make.names(colnames(yield_df))
colnames(yield_df)[colnames(yield_df)=="Yield_kg_mu"] <- "Yield"
colnames(yield_df)[colnames(yield_df)=="Biomass_kg_mu"] <- "Biomass"
colnames(yield_df)[colnames(yield_df)=="WUE..kg.mm.mu."] <- "WUE"
colnames(yield_df)[colnames(yield_df)=="NUE."] <- "NUE"
colnames(yield_df)[colnames(yield_df)=="PUE."] <- "PUE"
yield_df <- yield_df %>% filter(Year==2025)
yield_df <- yield_df[yield_df$Treatment %in% trt_levels,]
yield_df$Treatment <- factor(yield_df$Treatment, levels=trt_levels)
yield_df$Site <- factor(yield_df$Site, levels=c("Heyang","Yvci"), labels=c("Heyang","Yuci"))
pheno_vars <- c("Yield","Biomass","WUE","NUE","PUE")
pheno_labels <- c("Yield (kg/mu)","Biomass (kg/mu)","WUE (kg/mm/mu)","NUE (%)","PUE (%)")
pheno_all <- data.frame()
for(site in c("Heyang","Yuci")) {
for(i in seq_along(pheno_vars)) {
sub <- yield_df[yield_df$Site==site,]
r <- prepare_indicator(sub, pheno_vars[i], site, pheno_labels[i])
pheno_all <- rbind(pheno_all, r)
}
}
pheno_all$Site <- factor(pheno_all$Site, levels=c("Heyang","Yuci"))
pheno_all$Variable <- factor(pheno_all$Variable, levels=pheno_labels)
# 图3-1: 表型大图 (参考01脚本柱形图样式)
y_offset_letter <- 0.06
plot_cols <- function(summary_df, ncol, title) {
summary_df <- summary_df %>%
group_by(Variable, Site) %>%
mutate(
y_letter = max(mean+se, na.rm=TRUE) * (1 + y_offset_letter),
y_bottom = min(0, min(mean-se, na.rm=TRUE)) - max(mean, na.rm=TRUE)*0.12
) %>% ungroup()
ggplot(summary_df, aes(x=Treatment, y=mean, fill=Treatment)) +
geom_col(width=0.7, color="black", size=0.3, show.legend=FALSE) +
geom_errorbar(aes(ymin=mean-se, ymax=mean+se), width=0.15, size=0.5) +
geom_text(aes(y=mean, label=label_mean), vjust=1.8, color="white", size=3, fontface="plain") +
geom_text(aes(y=y_letter, label=letters), size=3.5, fontface="bold") +
geom_text(aes(y=y_bottom, label=label_bottom), size=2.2, color="darkred", lineheight=1.1) +
scale_fill_manual(values=color_palette) +
facet_wrap(~ Site + Variable, ncol=ncol, scales="free_y") +
labs(x=NULL, y=NULL, title=title) +
theme_bw(base_size=11) +
theme(
axis.text.x=element_text(angle=45, hjust=1, size=8, color="black"),
axis.text.y=element_text(size=8, color="black"),
strip.background=element_rect(fill="white", color="black", size=0.3),
strip.text=element_text(size=8, color="black"),
plot.title=element_text(hjust=0.5, size=13, face="bold"),
panel.grid.major.x=element_blank(),
panel.grid.minor=element_blank(),
panel.border=element_rect(color="black", size=0.5)
) +
scale_y_continuous(expand=expansion(mult=c(0.25, 0.15)))
}
p_pheno <- plot_cols(pheno_all, ncol=5, "图3-1 2025两地玉米产量与水肥利用效率（不同施菌时期）")
