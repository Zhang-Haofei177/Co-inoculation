plot.title=element_text(hjust=0.5, size=13, face="bold"),
panel.grid.major.x=element_blank(),
panel.grid.minor=element_blank(),
panel.border=element_rect(color="black", size=0.5)
) +
scale_y_continuous(expand=expansion(mult=c(0.25, 0.15)))
}
p_pheno <- plot_cols(pheno_all, ncol=5, "图3-1 2025两地玉米产量与水肥利用效率（不同施菌时期）")
p_pheno
ggsave(paste0(outdir,"图3-1_表型大图.pdf"), p_pheno, width=16, height=7, dpi=300, device=cairo_pdf)
ggsave(paste0(outdir,"图3-1_表型大图.png"), p_pheno, width=16, height=7, dpi=300)
# ================================================================
# 2. 读取土壤理化数据
# ================================================================
soil_df <- read.csv(file.path(env_base,"02_春玉米土壤理化和酶活性分析和绘图脚本/Top土壤理化性质绘图数据.csv"),
header=TRUE, check.names=FALSE)
colnames(soil_df) <- make.names(colnames(soil_df))
soil_df <- soil_df %>% filter(Year==2025)
soil_df <- soil_df[soil_df$Treatment %in% trt_levels,]
soil_df$Treatment <- factor(soil_df$Treatment, levels=trt_levels)
soil_df$Site <- factor(soil_df$Site, levels=c("Heyang","Yvci"), labels=c("Heyang","Yuci"))
soil_vars <- c("SOC.g.kg.","TN.g.kg.","AP.mg.kg.","TP.g.kg.","NH4.mg.kg.","NO3.mg.kg.")
soil_labels <- c("SOC (g/kg)","TN (g/kg)","AP (mg/kg)","TP (g/kg)","NH4 (mg/kg)","NO3 (mg/kg)")
soil_all <- data.frame()
for(site in c("Heyang","Yuci")) {
for(i in seq_along(soil_vars)) {
sub <- soil_df[soil_df$Site==site,]
r <- prepare_indicator(sub, soil_vars[i], site, soil_labels[i])
soil_all <- rbind(soil_all, r)
}
}
soil_all$Site <- factor(soil_all$Site, levels=c("Heyang","Yuci"))
soil_all$Variable <- factor(soil_all$Variable, levels=soil_labels)
# 图3-2: 土壤理化大图 (6列2行)
p_soil <- plot_cols(soil_all, ncol=6, "图3-2 2025两地土壤理化性质（不同施菌时期）")
p_soil
ggsave(paste0(outdir,"图3-2_土壤理化大图.pdf"), p_soil, width=16, height=7, dpi=300, device=cairo_pdf)
ggsave(paste0(outdir,"图3-2_土壤理化大图.png"), p_soil, width=16, height=7, dpi=300)
cat("图3-1 表型大图 + 图3-2 土壤理化大图 完成\n")
