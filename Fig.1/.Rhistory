library(dplyr); library(tidyr); library(ggplot2); library(agricolae); library(patchwork); library(showtext)
showtext_auto()
# Nature配色(参考01脚本, 取前5色)
color_palette <- c("#E64B35", "#4DBBD5", "#00A087", "#3C5488", "#F39B7F")
trt_levels <- c("Ctrl","AMF+Str(V3)","AMF+Str(V6)","AMF+Str(VT)","AMF+Str")
# 函数: 计算均值+SE+Tukey字母 (参考01脚本calc_letters)
calc_letters <- function(data_sub, response_var, group_col="Treatment") {
data_sub <- data_sub %>%
filter(!is.na(.data[[response_var]])) %>%
mutate(Treatment = factor(Treatment, levels = trt_levels))
summary <- data_sub %>%
group_by(Treatment) %>%
summarise(mean = mean(.data[[response_var]], na.rm=TRUE),
se = sd(.data[[response_var]], na.rm=TRUE)/sqrt(n()), .groups="drop")
aov_res <- aov(as.formula(paste(response_var, "~", group_col)), data = data_sub)
hsd <- HSD.test(aov_res, group_col, group=TRUE, console=FALSE)
letters_df <- data.frame(Treatment=rownames(hsd$groups), letters=hsd$groups$groups)
summary <- left_join(summary, letters_df, by="Treatment")
summary$letters <- ifelse(is.na(summary$letters), "", summary$letters)
summary
}
# 函数: 处理一个地点的一个指标, 返回带差值百分比的长格式数据(用于facet_wrap)
prepare_indicator <- function(data_sub, response_var, site_name, var_label) {
sum_df <- calc_letters(data_sub, response_var)
ctrl_mean <- sum_df %>% filter(Treatment == trt_levels[1]) %>% pull(mean) %>% first()
sum_df <- sum_df %>%
mutate(
diff = mean - ctrl_mean,
pct = (diff / ctrl_mean) * 100,
label_mean = sprintf("%.1f", mean),
label_diff = sprintf("%+.1f", diff),
label_pct = sprintf("(%+.1f%%)", pct),
label_bottom = paste0(label_diff, "\n", label_pct),
Site = site_name,
Variable = var_label
)
