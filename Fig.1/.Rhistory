# Fig.1C: Topsoil 团聚体粒径分布（3处理 × HY/YC）
# ============================================================================
library(ggplot2)
library(dplyr)
library(tidyr)
out_root <- "C:/Users/ADMIN/Desktop/Co-inoculation/Fig.1"
dir.create(out_root, showWarnings = FALSE, recursive = TRUE)
setwd(out_root)
# ---------- 1. 读取数据 ----------
df <- read.csv("data/25土壤理化_酶活性_团聚体汇总.csv", header = TRUE, row.names = 1)
df <- df[grepl("T1|T2|T6", rownames(df)), c(1:4, 17:19)]
df <- df[grepl("Topsoil", df$Niche), ]
df$Site <- factor(df$Site, levels = c("HY", "YC"), labels = c("Heyang", "Yvci"))
# ---------- 2. 计算各组分均值 ----------
df_summary <- df %>%
group_by(Group, Niche, Site, Treatment) %>%
summarise(
`粉黏粒 (≤52 μm)` = mean(X52um, na.rm = TRUE),
`微团聚体 (52-250 μm)` = mean(X52.250um, na.rm = TRUE),
`大团聚体 (≥250 μm)` = mean(X250um, na.rm = TRUE),
.groups = "drop"
) %>%
pivot_longer(
cols = c(`粉黏粒 (≤52 μm)`, `微团聚体 (52-250 μm)`, `大团聚体 (≥250 μm)`),
names_to = "component",
values_to = "percentage"
)
df_summary$component <- factor(df_summary$component,
levels = c("粉黏粒 (≤52 μm)", "微团聚体 (52-250 μm)", "大团聚体 (≥250 μm)"))
df_summary$Treatment <- factor(df_summary$Treatment,
levels = c("AMF", "Str", "AMF+Str"),
labels = c("AMF", "Str", "AMF+Str"))
# ---------- 3. 绘图 ----------
p <- ggplot(df_summary, aes(x = Treatment, y = percentage, fill = component)) +
geom_col(position = "stack", width = 0.7) +
facet_grid(~Site, scales = "free_x", space = "free") +
labs(x = "", y = "Aggregate size distribution (%)", title = "") +
scale_fill_manual(values = c("粉黏粒 (≤52 μm)" = "#FCB255",
"微团聚体 (52-250 μm)" = "#42B382",
"大团聚体 (≥250 μm)" = "#107BA4"),
labels = c("粉黏粒 (≤52 μm)" = "Clay + silt (≤52 μm)",
"微团聚体 (52-250 μm)" = "Microaggregates (52-250 μm)",
"大团聚体 (≥250 μm)" = "Macroaggregates (≥250 μm)")) +
theme_bw(base_size = 6) +
theme(legend.title = element_blank(),
legend.position = "none",
axis.text.x = element_text(angle = 45, hjust = 1, size = 6),
axis.text = element_text(color = "black", size = 6),
axis.title = element_text(size = 6),
legend.text = element_text(size = 6),
strip.text = element_text(size = 6),
strip.background = element_rect(fill = "white"))
ggsave(file.path(out_root, "Fig.1C_soil_aggregate.pdf"), p, width = 50, height = 40, units = "mm")
ggsave(file.path(out_root, "Fig.1C_soil_aggregate.png"), p, width = 50, height = 40, units = "mm", dpi = 300)
write.csv(df_summary, file.path(out_root, "Fig.1C_aggregate_data.csv"), row.names = FALSE)
cat("Fig.1C saved\n")
# ============================================================================
# Fig.S4: Rarefaction curves (Bacteria + Fungi, Niche + Treatment, 2×2)
# ============================================================================
library(vegan)
library(ggplot2)
library(patchwork)
out_root <- "C:/Users/ADMIN/Desktop/Co-inoculation/Fig.S4"
dir.create(out_root, showWarnings = FALSE, recursive = TRUE)
setwd(out_root)
# ---------- 1. 分组信息 ----------
group <- read.csv("data/group.csv", stringsAsFactors = FALSE)
colnames(group)[1] <- "names"
group <- group[group$Treatment %in% c("AMF","Str","AMF+Str") &
group$Niche %in% c("Topsoil","Rhizosphere","Endosphere"), ]
group$Niche <- factor(group$Niche, levels = c("Topsoil","Rhizosphere","Endosphere"))
group$Site  <- factor(group$Site, levels = c("HY","YC"), labels = c("Heyang","Yuci"))
# ---------- 2. Rarefaction 函数 ----------
ly.rare <- function(a, n) {
b <- rowSums(a)
i <- 1
n.i <- as.vector(c(seq(0, b[i], n), b[i]))
rare.i <- as.integer(rarefy(a[i, ], n.i))
rare <- cbind(rep(names(b)[i], length(n.i)), n.i, rare.i)
for (i in 2:length(b)) {
n.i <- as.vector(c(seq(0, b[i], n), b[i]))
rare.i <- as.integer(rarefy(a[i, ], n.i))
rare.ni <- cbind(rep(names(b)[i], length(n.i)), n.i, rare.i)
rare <- rbind(rare, rare.ni)
}
colnames(rare)[1:3] <- c("names","reads","value")
rare <- as.data.frame(rare)
rare$reads <- as.numeric(as.character(rare$reads))
rare$value <- as.numeric(as.character(rare$value))
rare
}
# ---------- 3. 处理函数 ----------
process <- function(asv_file, microbe_name, step = 2000) {
cat(sprintf("\n=== %s ===\n", microbe_name))
a1 <- read.csv(asv_file, row.names = 1, header = TRUE, check.names = FALSE)
a1 <- a1[, group$names]
a1 <- t(a1)
cat(sprintf("Samples: %d, ASVs: %d\n", nrow(a1), ncol(a1)))
rare <- ly.rare(a1, step)
rare.new <- merge(rare, group, by = "names")
# By Niche
p1 <- ggplot(rare.new, aes(reads, value, group = names, colour = Niche)) +
geom_line(linewidth = 0.3, alpha = 0.7) +
facet_wrap(~ Site, ncol = 2) +
scale_color_manual(values = c("Topsoil"="#FCB255","Rhizosphere"="#42B382","Endosphere"="#107BA4")) +
labs(x = "Number of sequences", y = "Number of ASVs", title = NULL) +
theme_bw(base_size = 6) +
theme(panel.grid = element_blank(),
strip.background = element_rect(fill = "white"),
strip.text = element_text(size = 6, color = "black"),
legend.key.size = unit(0.25, "cm"),
legend.text = element_text(size = 6),
legend.title = element_blank(),
axis.text = element_text(size = 6, color = "black"),
axis.title = element_text(size = 6, color = "black"),
plot.title = element_blank(),
text = element_text(family = "sans"))
# By Treatment
p2 <- ggplot(rare.new, aes(reads, value, group = names, colour = Treatment)) +
geom_line(linewidth = 0.3, alpha = 0.7) +
facet_wrap(~ Site, ncol = 2) +
scale_color_manual(values = c("AMF"="#FCB255","Str"="#42B382","AMF+Str"="#107BA4")) +
labs(x = "Number of sequences", y = "Number of ASVs", title = NULL) +
theme_bw(base_size = 6) +
theme(panel.grid = element_blank(),
strip.background = element_rect(fill = "white"),
strip.text = element_text(size = 6, color = "black"),
legend.key.size = unit(0.25, "cm"),
legend.text = element_text(size = 6),
legend.title = element_blank(),
axis.text = element_text(size = 6, color = "black"),
axis.title = element_text(size = 6, color = "black"),
plot.title = element_blank(),
text = element_text(family = "sans"))
return(list(p1 = p1, p2 = p2))
}
# ---------- 4. 生成并拼合 ----------
bac_plots <- process("data/BAC_Absolute.csv", "Bacteria")
fun_plots <- process("data/FUN_Absolute.csv", "Fungi")
combined <- (bac_plots$p1 + fun_plots$p1) / (bac_plots$p2 + fun_plots$p2) +
plot_annotation(
title = "Rarefaction curves",
tag_levels = "A",
theme = theme(
plot.title = element_text(size = 6, hjust = 0.5, face = "bold", family = "sans"),
plot.tag = element_text(size = 6, face = "bold", family = "sans")
)
)
ggsave(file.path(out_root, "Fig.S4_rarefaction.pdf"), combined, width = 200, height = 80, units = "mm")
ggsave(file.path(out_root, "Fig.S4_rarefaction.png"), combined, width = 200, height = 80, units = "mm", dpi = 300)
cat("Fig.S4 saved\n")
# ============================================================================
# 真菌 bin 数据筛选：从 BinContributeToProcess 提取协同效应比较
# （基于细菌版等效改写）
# ============================================================================
library(dplyr)
library(tidyr)
# ---------- 0. 路径 ----------
wd <- "C:/Users/ADMIN/Desktop/Co-inoculation/Fig.2/iCAMP/Output_simple"
setwd(wd)
# ---------- 1. 读取原始 iCAMP bin 贡献 ----------
df <- read.csv("Fungi_treatment.BinContributeToProcess_EachGroup.csv", header = TRUE)
# ---------- 2. 提取同生态位内双菌 vs 单菌 ----------
df_vs <- df %>%
filter(grepl("_vs_", Group)) %>%
filter(grepl("T6", Group)) %>%
filter(grepl("T1", Group) | grepl("T2", Group)) %>%
mutate(
left_part  = sub("_vs_.*", "", Group),
right_part = sub(".*_vs_", "", Group),
left_site_niche  = sub("\\.T[126]$", "", left_part),
right_site_niche = sub("\\.T[126]$", "", right_part)
) %>%
filter(left_site_niche == right_site_niche) %>%
select(-left_part, -right_part, -left_site_niche, -right_site_niche) %>%
mutate(Contrast = case_when(
grepl("T1", Group) & grepl("T6", Group) ~ "vs_AMF",
grepl("T2", Group) & grepl("T6", Group) ~ "vs_Str",
TRUE ~ "Other"
)) %>%
filter(Contrast != "Other")
# ---------- 3. 解析地点与生态位 ----------
df_vs <- df_vs %>%
mutate(
first_part = sub("_vs_.*", "", Group),
Site = case_when(
substr(first_part, 1, 1) == "H" ~ "HY",
substr(first_part, 1, 1) == "T" ~ "YC",
TRUE ~ "Other"
),
Niche = case_when(
grepl("\\.T\\.", first_part) ~ "Topsoil",
grepl("\\.S\\.", first_part) ~ "Subsoil",
grepl("\\.B\\.", first_part) ~ "Bottom soil",
grepl("\\.R\\.", first_part) ~ "Rhizosphere",
grepl("\\.E\\.", first_part) ~ "Endosphere",
TRUE ~ "Other"
)
) %>%
filter(Site != "Other", Niche != "Other") %>%
select(-first_part)
cat("\n===== 各生态位数据行数 =====\n")
print(table(df_vs$Niche))
# 保存筛选结果
write.csv(df_vs, "真菌_筛选的协同效应处理之间的群落构建过程带bin.csv", row.names = FALSE)
cat("筛选完成：", nrow(df_vs), "行\n")
# ============================================================================
# 细菌 bin 数据筛选：从 BinContributeToProcess 提取协同效应比较
